# ==============================================================================
# NEXA ECOSYSTEM — TEMPLATE DE VARIÁVEIS DE AMBIENTE
# ==============================================================================
# ATENÇÃO: NUNCA insira credenciais reais ou chaves privadas neste arquivo.
# Copie este arquivo para .env.local em cada app ou configure no painel das plataformas.

# ------------------------------------------------------------------------------
# 1. FRONTENDS (apps/pay, apps/mobile, apps/chat) — VALORES PÚBLICOS (Vercel)
# ------------------------------------------------------------------------------
# URL da API do backend (Render em produção ou http://localhost:10000 em dev)
VITE_API_BASE_URL=http://localhost:10000

# URL do servidor Socket.IO (geralmente igual à URL da API)
VITE_SOCKET_URL=http://localhost:10000

# Firebase Client SDK — Configuração pública da aplicação web no console Firebase
VITE_FIREBASE_API_KEY=AIzaSyExampleFakeKeyForTemplate00000000
VITE_FIREBASE_AUTH_DOMAIN=nexa-ecosystem-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nexa-ecosystem-demo
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_VAPID_PUBLIC_KEY=BL_FakeVapidKeyForWebPushNotificationTemplate000000

# Cloudinary — Nome da conta (público para transformações e upload direto assinado)
VITE_CLOUDINARY_CLOUD_NAME=nexa-cloud-demo

# URLs dos frontends para navegação entre sites
VITE_PAY_URL=http://localhost:5173
VITE_MOBILE_URL=http://localhost:5174
VITE_CHAT_URL=http://localhost:5175

# ------------------------------------------------------------------------------
# 2. BACKEND (apps/api) — SEGREDOS E CONFIGURAÇÕES DE SERVIÇO (Render)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=10000
LOG_LEVEL=info

# Origens permitidas para CORS (sem barra no final)
FRONTEND_PAY_ORIGIN=http://localhost:5173
FRONTEND_MOBILE_ORIGIN=http://localhost:5174
FRONTEND_CHAT_ORIGIN=http://localhost:5175

# Firebase Admin SDK (Segredos de Servidor)
# DICA RENDER: Para a FIREBASE_PRIVATE_KEY, mantenha as quebras de linha com \n ou cole o conteúdo cru.
FIREBASE_PROJECT_ID=nexa-ecosystem-demo
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@nexa-ecosystem-demo.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Firebase Emulator (Opcional — quando ativo, a API ignora as credenciais reais e usa emulador local)
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Cloudinary — Credenciais de Servidor para emissão de assinaturas de upload HMAC-SHA1
CLOUDINARY_CLOUD_NAME=nexa-cloud-demo
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz12345

# WebRTC STUN & TURN
# Em desenvolvimento, servidores STUN públicos (ex: stun:stun.l.google.com:19302) são usados automaticamente.
# Em produção, configure um TURN provider (ex: Metered, Twilio, Coturn) para contornar NATs corporativos restritos.
TURN_SERVER_URL=turn:standard.turnserver.com:3478
TURN_SHARED_SECRET=your_turn_static_shared_secret_or_token
